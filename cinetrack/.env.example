# Copie este arquivo para .env e preencha com os valores locais.
# O arquivo .env NÃO deve ser enviado ao GitHub.

# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave

# Chave da API do TMDB (https://www.themoviedb.org/settings/api). Nunca versionar o valor real.
TMDB_API_KEY=
